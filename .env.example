TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=mygoals_bot
PORT=3000

# Signs long-lived auth tokens (goals_token httpOnly cookie + Bearer for Pages).
# Login persists ~400 days across Render Free sleep/restarts — in-memory sessions alone are not enough.
SESSION_SECRET=

# Cross-origin (GitHub Pages → Render). Comma-separated list.
# On Render Free set via render.yaml / dashboard.
CORS_ORIGINS=https://vgametikok.github.io

# Secure + SameSite=None cookies for cross-site session (required on Render HTTPS).
# Also auto-enabled when NODE_ENV=production.
COOKIE_SECURE=1

# Optional: webhook instead of long polling (not needed on Render Free — use polling).
# WEBHOOK_URL=https://goals-bot.onrender.com
# WEBHOOK_PATH=/telegram/webhook
