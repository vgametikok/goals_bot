TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=mygoals_bot
PORT=3000

# Signs long-lived auth tokens (goals_token httpOnly cookie + Bearer for Pages).
# Login persists ~400 days across legacy host Free sleep/restarts — in-memory sessions alone are not enough.
SESSION_SECRET=

# Cross-origin (GitHub Pages → legacy host). Comma-separated list.
# On legacy host Free set via render.yaml / dashboard.
CORS_ORIGINS=https://vgametikok.github.io

# Secure + SameSite=None cookies for cross-site session (required on legacy host HTTPS).
# Also auto-enabled when NODE_ENV=production.
COOKIE_SECURE=1

# MongoDB Atlas (free M0). Required on legacy host for persistent users/calendars.
# Without MONGODB_URI the app falls back to ephemeral data/store.json (local/dev).
MONGODB_URI=
MONGODB_DB=goals_bot

# Optional: webhook instead of long polling (not needed on legacy host Free — use polling).
# WEBHOOK_URL=https://goals-bot.onrender.com
# WEBHOOK_PATH=/telegram/webhook
